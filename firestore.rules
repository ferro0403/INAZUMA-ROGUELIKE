rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUsernameKey(value) {
      return value is string && value.size() >= 3 && value.size() <= 16
        && value.matches('^[a-z][a-z0-9_]{2,15}$');
    }
    function validVisibleUsername(value) {
      return value is string && value.size() >= 3 && value.size() <= 16
        && value.matches('^[A-Za-z][A-Za-z0-9_]{2,15}$');
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameNormalized', 'createdAt', 'updatedAt', 'cloudSchemaVersion'])
        && validVisibleUsername(request.resource.data.username)
        && validUsernameKey(request.resource.data.usernameNormalized)
        && request.resource.data.cloudSchemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/users/$(uid))
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)).data.uid == uid;
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameNormalized == resource.data.usernameNormalized
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.cloudSchemaVersion is int;
      match /{document=**} { allow read, write: if isOwner(uid); }
    }

    match /usernames/{usernameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && validUsernameKey(usernameKey)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameNormalized', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validVisibleUsername(request.resource.data.username)
        && request.resource.data.usernameNormalized == usernameKey
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameNormalized == usernameKey;
      allow update, delete: if false;
    }

    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameNormalized', 'avatarId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && validVisibleUsername(request.resource.data.username)
        && validUsernameKey(request.resource.data.usernameNormalized)
        && request.resource.data.avatarId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)).data.uid == uid;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameNormalized', 'avatarId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameNormalized == resource.data.usernameNormalized;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
